# 公司内网大模型统一网关示例。复制相应变量到 local-server/.env，并由管理员自行填写真实值。
# URL 是公司推理服务地址：若公司给的是完整 /inference/... 地址请原样填写；若给的是 .../v1，系统会自动补 /chat/completions。

# 默认模型与自动回退顺序
LLM_DEFAULT_PROVIDER=deepseek
LLM_FALLBACK_PROVIDERS=glm,qwen,deepseek-cloud

# DeepSeek（默认）
COMPANY_DEEPSEEK_API_URL=
COMPANY_DEEPSEEK_API_KEY=
COMPANY_DEEPSEEK_MODEL=DeepSeek-V4-Flash-0731

# GLM
GLM_API_URL=
GLM_API_KEY=
GLM_MODEL=GLM-4.5

# Qwen
QWEN_API_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen3.6-27B

# 原来的云端DeepSeek配置继续保留；统一网关会在公司三模型均不可用时最后调用它。
