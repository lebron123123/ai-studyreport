# ===== PPT 云端生图：Nano Banana =====
# 默认关闭。确认仅发送脱敏后的视觉提示词后再改为 true。
NANO_BANANA_ENABLED=false
GEMINI_API_KEY=
# 第三方API易使用apiyi；Google官方直连使用google
NANO_BANANA_PROVIDER=apiyi
NANO_BANANA_API_URL=https://api.apiyi.com/v1/chat/completions
NANO_BANANA_MODE=standard
APIYI_NANO_BANANA_MODEL=gemini-3.1-flash-image-preview
# fast=gemini-3.1-flash-lite-image
# standard=gemini-3.1-flash-image
# premium=gemini-3-pro-image
NANO_BANANA_IMAGE_SIZE=1K
NANO_BANANA_TIMEOUT_MS=180000

# ===== PPT 本地生图：ComfyUI / Stable Diffusion =====
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_WORKFLOW=ppt-image-hero
COMFYUI_WORKFLOW_DIR=
COMFYUI_NEGATIVE_PROMPT=文字，水印，标志，低清晰度，畸变建筑，错误透视
COMFYUI_REQUEST_TIMEOUT_MS=30000
COMFYUI_TIMEOUT_MS=240000
COMFYUI_POLL_MS=1000

# 一块GPU建议设为1；云端API可按额度调整，最大4。
PPT_IMAGE_MAX_CONCURRENCY=1
