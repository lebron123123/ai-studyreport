# 依赖目录，体积大且可通过 package-lock.json 重新安装
node_modules/

# 本地部署的真实密钥/数据库连接串——绝不能进公开仓库
local-server/.env
.env
.env.*
!local-server/.env.image.example
!local-server/.env.llm.example

# Claude Code 本地会话配置（含权限缓存，可能带调试用的临时token），机器本地专用
.claude/

# DeepSeek Harness 本地递归备份；仅用于人工回溯，禁止参与扫描、修改和提交
.dsh-filess/

# 常见系统/编辑器噪音文件
.DS_Store
Thumbs.db
*.log
集团大模型检测结果.txt

# 本地用户上传的PPT模板与运行期资料，不进入源码仓库
local-data/

# PPT自动化验收生成物；保留实现文档和清单JSON，忽略二进制及渲染目录
outputs/*.pptx
outputs/*.json
outputs/*.html
outputs/*.jpg
outputs/*.jpeg
outputs/*.png
outputs/*.docx
outputs/*.xls
outputs/*.xlsx
outputs/*-render/
outputs/*-render*/
outputs/*-slides/
outputs/*-generated-slides/
outputs/_preview-smoke/
outputs/ppt-export-current/
outputs/ppt-native-samples/
outputs/ppt-template-timeline-pages/
outputs/ppt-web-native-render/
outputs/ppt-wysiwyg-render/

# 外部 Housing / anju-pc 参考项目的分析产物仅保留在外部学习资料目录，不进入本仓库
outputs/**/*anju-pc*
outputs/**/*anju_pc*
outputs/**/*Housing*Investment_OS*
outputs/**/*Housing*规划基线*

# 本地检查、解析脚本和第三方便携依赖缓存
.tmp/
tools/vendor/
**/__pycache__/
*.pyc

# 宠物正式网页素材进入 assets/pets；制作源片、PSD、Blender和QA抽帧仅本地保留
outputs/pet-3d-source/**/*.blend
outputs/pet-3d-source/**/*.blend1
outputs/pet-3d-source/**/*.png
outputs/pet-live2d-source/**/*.psd
outputs/pet-live2d-source/**/*.cmo3
outputs/pet-live2d-source/**/*.png
outputs/pet-video-source/**/*.mp4
outputs/pet-video-source/**/*.png
outputs/pet-video-source/**/*.json

# 可重新下载的超大地图原始数据不进入 Git（GitHub 单文件上限 100 MiB）
outputs/baoan-source/*.osm.pbf

# Cloudflare Pages 单文件上限为 25 MiB；这些本地原始数据/模型不进入静态发布包
local-server/chi_sim.traineddata
outputs/baoan-source/parallel-parts/
outputs/city-dem-source/*.tif
project-map/city/buildings.glb
project-map/baoan-lod-v1/overview-known.glb
